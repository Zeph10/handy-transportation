# ---------------------------------------------------------------------------
# Web app (apps/web) — copy to apps/web/.env.local for development.
# These are PUBLIC values compiled into the browser bundle. Never put secrets here.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-local-or-project-anon-key
# Cloudflare Turnstile site key (public). Leave empty locally to skip the widget.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Edge Function secrets — set with `supabase secrets set --env-file supabase/.env`
# (copy this section to supabase/.env, which is git-ignored). NEVER commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided
# automatically to deployed functions.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Handy Transportation <support@bychuckhandy.com>"
# Long random string shared with the pg_cron job that triggers reminders.
CRON_SECRET=generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# GitHub Actions secrets (Settings → Secrets and variables → Actions) for backups:
#   SUPABASE_DB_URL      postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   BACKUP_AGE_PUBLIC_KEY  age1... (public key; the private key stays offline with the owner)
# ---------------------------------------------------------------------------
